.nearby-page {
  min-height: 100vh;
  background: #f8f6f2;
  padding: 50px 6%;
}

.nearby-header {
  text-align: center;
  margin-bottom: 30px;
}

.nearby-header h1 {
  font-family: Georgia, serif;
  font-size: 38px;
  color: #222;
  margin-bottom: 10px;
}

.nearby-header p {
  color: #666;
  font-size: 16px;
}

.map-box {
  max-width: 1100px;
  height: 500px;
  margin: auto;
  background: white;
  padding: 10px;
  border-radius: 8px;
  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
}

.leaflet-container {
  width: 100%;
  height: 100%;
  border-radius: 5px;
}